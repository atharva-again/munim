# YugabyteDB YSQL connection string. Use a TEST/DEV cluster.
DATABASE_URL=postgresql://user:password@host:5433/munim?sslmode=require
MUNIM_BUSINESS_ID=demo-business
PORT=3001

# Meko MCP. Keep this key server-side.
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp

# Razorpay TEST mode credentials only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google-only authentication. Use the browser-facing origin, including Vite in dev.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LiveKit Cloud and Sarvam (server/worker only; never VITE_ variables).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
# Optional persona voice; omitted uses Sarvam's model default.
SARVAM_TTS_SPEAKER=
GROQ_API_KEY=
MUNIM_LLM_MODEL=openai/gpt-oss-120b
# Reachable backend URL for the voice worker, not necessarily the public browser origin.
MUNIM_API_URL=http://localhost:3001

# Per-account runtime memory. Existing MEKO_DATAPACK_ID is a bootstrap trace only;
# no shop finance conversations are written into that bootstrap/build datapack.
MEKO_PROVISIONING_DATAPACK_ID=
# Stable optional namespace for globally unique runtime datapack names.
MEKO_DEPLOYMENT_NAMESPACE=
MUNIM_MEMORY_ENABLED=true
MUNIM_MEMORY_RECALL_TIMEOUT_MS=3000
# Bound response-path memory reads; extraction runs in the API background queue.
MUNIM_LLM_REASONING_EFFORT=low
MUNIM_LLM_MAX_TOKENS=1600
MUNIM_LLM_TIMEOUT_MS=12000
MUNIM_API_MAX_REQUESTS=64

# Tuning baselines, not measured quality or latency guarantees.
SARVAM_STT_STREAM_TYPE=balanced
SARVAM_STT_SILENCE_MS=600
SARVAM_STT_THRESHOLD=0.6
SARVAM_STT_MIN_SPEECH_MS=300
# Optional JSON array of common product terms; no cross-shop customer names.
SARVAM_STT_KEYTERMS=[]
MUNIM_VAD_ACTIVATION_THRESHOLD=0.65
MUNIM_VAD_MIN_SPEECH_MS=350
MUNIM_VAD_MIN_SILENCE_MS=650
SARVAM_TTS_TIMEOUT_MS=15000
MUNIM_ENDPOINT_MIN_DELAY_MS=100
MUNIM_ENDPOINT_MAX_DELAY_MS=1800
MUNIM_INTERRUPTION_MIN_MS=650
MUNIM_INTERRUPTION_MIN_WORDS=1
MUNIM_FALSE_INTERRUPTION_MS=1200
MUNIM_VOICE_IDLE_PROCESSES=1
MUNIM_VOICE_MAX_JOBS=4
MUNIM_VOICE_DRAIN_TIMEOUT_MS=120000
MUNIM_VOICE_BACKEND_TIMEOUT_MS=30000
