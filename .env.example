# YugabyteDB YSQL connection string. Use a TEST/DEV cluster.
DATABASE_URL=postgresql://user:password@host:5433/munim?sslmode=require
MUNIM_BUSINESS_ID=demo-business
PORT=3001

# Meko MCP. Keep this key server-side.
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp

# Razorpay TEST mode credentials only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google-only authentication. Use the browser-facing origin, including Vite in dev.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this verified Google email can access the pre-auth ledger and shared integrations.
# Other Google accounts receive their own empty, isolated ledger.
MUNIM_OWNER_EMAIL=

# LiveKit Cloud and Sarvam (server/worker only; never VITE_ variables).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
# Optional persona voice; omitted uses Sarvam's model default.
SARVAM_TTS_SPEAKER=
GEMINI_API_KEY=
MUNIM_LLM_MODEL=gemini-3.8-flash
# Reachable backend URL for the voice worker, not necessarily the public browser origin.
MUNIM_API_URL=http://localhost:3001
